<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecourja Home</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <img src="/ecourja.jpg" alt="Ecourja Logo" width="50">
        <h1>Home</h1>
    </header>

    <div id="auth-links">
        <% if (user) { %>
            <p>Hello, <%= user.username %></p><a href="/logout">Logout</a>
        <% } else { %>
            <a href="/login">Login</a><br><a href="/register">Register</a>
        <% } %>
    </div>
</body>
</html>