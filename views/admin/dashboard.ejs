<%- include('layout', { title: 'Admin Dashboard' }) %>

<div class="row">
    <div class="col-md-6">
        <div class="stats-card">
            <h3>Categories</h3>
            <div class="number"><%= stats.categories %></div>
            <a href="/admin/categories" class="btn btn-primary">Manage Categories</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stats-card">
            <h3>Products</h3>
            <div class="number"><%= stats.products %></div>
            <a href="/admin/products" class="btn btn-primary">Manage Products</a>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Quick Start Guide</h5>
                <ol>
                    <li>First, create categories for your products (e.g., "eMobility", "Renewable Energy")</li>
                    <li>Then add products to each category</li>
                    <li>You can update product details and status anytime</li>
                    <li>Use the filter on the products page to manage products by category</li>
                </ol>
            </div>
        </div>
    </div>
</div>