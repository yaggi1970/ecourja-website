<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Ecourja Innovations - Renewable energy solutions (solar & wind)">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <style>
                .about-justified p {
                    text-align: justify !important;
                }
        .dropdown:hover .dropdown-menu {
            display: block;
        }
        .dropdown-menu {
            margin-top: 0;
        }
    </style>
    <!-- Modern font for the entire website -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body, .navbar, .btn, .form-control, .display-4, h1, h2, h3, h4, h5, h6, p, a, .lead {
            font-family: 'Montserrat', Arial, sans-serif !important;
        }
        /* Headings - Dark Green */
        .gradient-heading {
            font-weight: 900 !important;
            color: #014421 !important;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>


    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@900&display=swap" rel="stylesheet">
    <style>
        .dynamic-hero {
            font-family: 'Montserrat', Arial, sans-serif;
            font-weight: 900;
            font-size: 3rem;
            color: #f8f8ff;
            text-shadow: 0 2px 16px rgba(0,0,0,0.25), 0 2px 8px #fff;
            letter-spacing: 2px;
            animation: popIn 1.2s cubic-bezier(.68,-0.55,.27,1.55);
        }
        @keyframes popIn {
            0% { transform: scale(0.8) translateY(30px); opacity: 0; }
            80% { transform: scale(1.05) translateY(-5px); opacity: 1; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }
    </style>
    <section class="hero text-white text-center py-5 animate__animated animate__fadeIn" style="background: #014421;">
        <div class="hero-content container">
            <h1 class="dynamic-hero">Power Your World Sustainably</h1>
            <p class="lead fw-bold">Leading the way in renewable energy solutions</p>
        </div>
    </section>

    <section id="about" class="section-container py-5 bg-light">
        <div class="content-wrapper container">
            <h2 class="text-center mb-4 gradient-heading">About Us</h2>
            <div class="row align-items-center mb-5 flex-column-reverse flex-md-row about-justified">
                <div class="col-md-6 order-2 order-md-1 mt-4 mt-md-0">
                    <h3 class="h4 mb-4 gradient-heading">Pioneering Sustainable Energy & eMobility Solutions</h3>
                    <p class="lead mb-4">At Ecourja Innovations, we're more than just an energy company – we're architects of a sustainable future in renewable energy and electric mobility.</p>
                    <p class="mb-4">Founded with a vision to revolutionize India's energy landscape, we specialize in developing and implementing cutting-edge renewable energy solutions that combine solar and wind technologies with smart grid integration. Beyond energy generation, we're driving innovation in eMobility through the development of advanced automotive subsystems.</p>
                    <div class="mission-vision mb-4">
                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-bullseye text-primary mt-1 me-3 fa-lg"></i>
                            <div>
                                <h4 class="h5 mb-2">Our Mission</h4>
                                <p>To accelerate India's transition to sustainable energy and electric mobility through innovative technologies, advanced subsystem development, and accessible solutions that empower communities and businesses.</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <i class="fas fa-eye text-primary mt-1 me-3 fa-lg"></i>
                            <div>
                                <h4 class="h5 mb-2">Our Vision</h4>
                                <p>To be the driving force behind India's renewable energy revolution and eMobility transformation, creating a future where clean, reliable power and sustainable transportation are accessible to all.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Achievement boxes removed as requested -->
            </div>

            <!-- eMobility & Subsystems Section -->
            <div class="row mt-5 mb-5">
                <div class="col-md-12">
                    <div class="bg-white rounded shadow-sm p-5">
                        <h3 class="h4 text-center mb-4 gradient-heading">
                            <i class="fas fa-charging-station text-primary me-2"></i>
                            eMobility & Advanced Subsystem Development
                        </h3>
                        <p class="text-center lead mb-5">Driving the future of electric vehicles through innovative subsystem engineering and integration</p>
                        
                        <div class="row g-4 mb-5">
                            <div class="col-md-6">
                                <div class="subsystem-card p-4 border-start border-primary border-4">
                                    <h5 class="mb-3">
                                        <i class="fas fa-car-side text-primary me-2"></i>
                                        Electric Power Steering (EPS)
                                    </h5>
                                    <p class="mb-3">We develop advanced Electric Power Steering systems that deliver precise control, energy efficiency, and enhanced safety for electric vehicles. Our EPS solutions integrate seamlessly with vehicle dynamics, providing:</p>
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Adaptive steering assistance based on vehicle speed</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Energy-efficient brushless motor technology</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Fail-safe mechanisms for enhanced safety</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>CAN bus integration for smart vehicle systems</li>
                                    </ul>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="subsystem-card p-4 border-start border-success border-4">
                                    <h5 class="mb-3">
                                        <i class="fas fa-microchip text-success me-2"></i>
                                        Battery Management Systems (BMS)
                                    </h5>
                                    <p class="mb-3">Our intelligent BMS solutions ensure optimal battery performance, longevity, and safety through advanced monitoring and control:</p>
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Real-time cell voltage and temperature monitoring</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>State of Charge (SOC) and State of Health (SOH) estimation</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Active and passive cell balancing</li>
                                        <li class="mb-2"><i class="fas fa-check-circle text-success me-2"></i>Thermal management and protection circuits</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <div class="subsystem-feature text-center p-4 bg-light rounded">
                                    <i class="fas fa-plug text-primary fa-3x mb-3"></i>
                                    <h6 class="mb-2">Onboard Chargers (OBC)</h6>
                                    <p class="small mb-0">High-efficiency AC-DC conversion systems with smart charging algorithms and thermal management</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="subsystem-feature text-center p-4 bg-light rounded">
                                    <i class="fas fa-bolt text-warning fa-3x mb-3"></i>
                                    <h6 class="mb-2">DC-DC Converters</h6>
                                    <p class="small mb-0">Bidirectional power converters for auxiliary systems and battery-to-battery power management</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="subsystem-feature text-center p-4 bg-light rounded">
                                    <i class="fas fa-tachometer-alt text-info fa-3x mb-3"></i>
                                    <h6 class="mb-2">Vehicle Control Units (VCU)</h6>
                                    <p class="small mb-0">Central computing units that orchestrate all EV subsystems for optimal performance and efficiency</p>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Industry Collaboration:</strong> We partner with leading automotive manufacturers and research institutions to develop next-generation eMobility solutions that meet international safety and performance standards.
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row mt-5">
                <div class="col-md-12">
                    <h3 class="h4 text-center mb-4 gradient-heading">Why Choose Ecourja?</h3>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="feature-card text-center p-4 bg-white rounded shadow-sm h-100">
                                <i class="fas fa-cogs text-primary fa-2x mb-3"></i>
                                <h4 class="h5 mb-3">Innovation at Core</h4>
                                <p>Our proprietary nanogrid technology, smart energy management systems, and advanced EV subsystems represent the cutting edge of renewable energy and eMobility solutions.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-card text-center p-4 bg-white rounded shadow-sm h-100">
                                <i class="fas fa-hands-helping text-primary fa-2x mb-3"></i>
                                <h4 class="h5 mb-3">Expert Support</h4>
                                <p>Our team of experienced engineers and technicians provides end-to-end support, from design and prototyping to installation, integration, and maintenance.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-card text-center p-4 bg-white rounded shadow-sm h-100">
                                <i class="fas fa-chart-line text-primary fa-2x mb-3"></i>
                                <h4 class="h5 mb-3">Proven Results</h4>
                                <p>Our installations have helped customers achieve up to 70% reduction in energy costs while our EV subsystems enhance vehicle efficiency, safety, and performance.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="products" class="section-container py-5">
        <div class="content-wrapper container">
            <h2 class="text-center mb-4 gradient-heading">Our Products</h2>
            <p class="text-center mb-5">Innovative nanogrid solutions for every scale of need</p>
            
            <div class="row g-4">
                <% products.forEach(product => { %>
                <div class="col-md-4">
                    <div class="product-card h-100 bg-white rounded shadow-sm overflow-hidden">
                        <div class="product-image position-relative">
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-100" 
                                 onerror="this.src='https://placehold.co/400x300/f8f9fa/495057/png?text=<%= encodeURIComponent(product.name) %>'">
                            <span class="badge <%= product.badgeClass %> position-absolute top-0 end-0 m-3"><%= product.category %></span>
                        </div>
                        <div class="product-content p-4">
                            <h3 class="h4 mb-3"><%= product.name %></h3>
                            <div class="specs mb-3">
                                <div class="spec-item d-flex align-items-center mb-2">
                                    <i class="fas fa-bolt text-primary me-2"></i>
                                    <span><%= product.specs.inverter %></span>
                                </div>
                                <div class="spec-item d-flex align-items-center mb-2">
                                    <i class="fas fa-solar-panel text-primary me-2"></i>
                                    <span><%= product.specs.generation %></span>
                                </div>
                                <div class="spec-item d-flex align-items-center">
                                    <i class="fas fa-battery-full text-primary me-2"></i>
                                    <span><%= product.specs.storage %></span>
                                </div>
                            </div>
                            <p class="mb-4"><%= product.description %></p>
                            <a href="/product/<%= product.id %>" class="btn btn-outline-primary">Learn More</a>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
        </div>
    </section>

    <section id="calculation" class="section-container">
        <div class="content-wrapper container">
            <h2 class="text-center mb-4 gradient-heading">Energy Savings Calculators</h2>
            <p class="text-center mb-5">Estimate your potential savings with our renewable energy solutions</p>
            <div id="solar-calculator" class="calculator-section">
                <h3>Solar Energy Calculator</h3>
                <div class="calculator">
                    <div class="calc-input">
                        <label for="monthlyBill">
                            Monthly Electricity Bill (₹):
                            <input type="number" id="monthlyBill" name="monthlyBill" min="0" placeholder="Enter amount">
                        </label>
                        <label for="sunlightHours">
                            Average Daily Sunlight Hours:
                            <input type="number" id="sunlightHours" name ="sunlightHours" min="0" max="12" placeholder="Enter hours">
                        </label>
                    </div>
                    <button id="calculateSolarBtn" class="calc-button">Calculate Savings</button>
                    <div id="solarResults" class="results-grid">
                        <div class="result-item">
                            <h4>Annual Savings</h4>
                            <p id="annualSavings">₹0</p>
                        </div>
                        <div class="result-item">
                            <h4>CO2 Reduction (tons/year)</h4>
                            <p id="carbonReduction">0</p>
                        </div>
                        <div class="result-item">
                            <h4>ROI (years)</h4>
                            <p id="roi">0</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="wind-calculator" class="calculator-section">
                <h3>Wind Energy Calculator</h3>
                <div class="calculator">
                    <div class="calc-input">
                        <label for="avgWindSpeed">
                            Average Wind Speed (km/h):
                            <input type="number" id="avgWindSpeed" name="avgWindSpeed" min="0" placeholder="Enter speed">
                        </label>
                        <label for="propertySize">
                            Property Size (sq. meters):
                            <input type="number" id="propertySize" name="propertySize" min="0" placeholder="Enter size">
                        </label>
                    </div>
                    <button id="calculateWindBtn" class="calc-button">Calculate Potential</button>
                    <div id="windResults" class="results-grid">
                        <div class="result-item">
                            <h4>Annual Energy (kWh)</h4>
                            <p id="windEnergy">0</p>
                        </div>
                        <div class="result-item">
                            <h4>Annual Savings</h4>
                            <p id="windSavings">₹0</p>
                        </div>
                        <div class="result-item">
                            <h4>Payback Period (years)</h4>
                            <p id="windRoi">0</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="section-container">
        <div class="content-wrapper">
            <h2 style="color:#014421;">Contact Us</h2>
            <div class="contact-grid">
                <div class="contact-form">
                    <h3 style="color:#014421; font-size:1.1rem;">Send us a message</h3>
                    <form id="contactForm" method="post">
                        <label for="name">Name:</label>
                        <input type="text" id="name" name="name" required>

                        <label for="email">Email:</label>
                        <input type="email" id="email" name="email" required>

                        <label for="message">Message:</label>
                        <textarea id="message" name="message" rows="2" style="resize:vertical; min-height:40px; max-height:100px;" required></textarea>

                        <button type="submit">Send Message</button>
                    </form>
                    <div id="contactStatus" style="margin-top:12px"></div>
                </div>
                <div class="contact-info">
                    <div class="contact-item">
                        <i class="fas fa-envelope" style="color:#014421;"></i>
                        <p>Email: <a href="mailto:info@ecourja.com">info@ecourja.com</a></p>
                    </div>
                    <div class="contact-item" style="display:flex;align-items:center;gap:8px;">
                        <i class="fas fa-phone" style="color:#014421;"></i>
                        <span>Phone: +91 95459 06844</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

        <script>
        // Minimal client-side submit handler to post to /contact
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contactForm');
            const status = document.getElementById('contactStatus');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                status.textContent = 'Sending...';
                const payload = {
                    name: form.name.value,
                    email: form.email.value,
                    message: form.message.value
                };
                try {
                    const res = await fetch('/contact', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok && data.ok) {
                        status.textContent = 'Message sent — thank you!';
                        form.reset();
                    } else {
                        status.textContent = 'Error sending message: ' + (data.error || 'unknown');
                    }
                } catch (err) {
                    status.textContent = 'Network error — please try again later.';
                }
            });
        });
        </script>

        <%- include('partials/footer') %>
