<%- include('partials/header') %>

<style>
    body.register-bg {
        background: linear-gradient(135deg, #fdf6e3 0%, #e0eafc 100%);
        min-height: 100vh;
    }
    .auth-card {
        border: none;
        border-radius: 1.5rem;
        box-shadow: 0 4px 32px rgba(0,0,0,0.08);
        padding: 2rem 2.5rem 2rem 2.5rem;
        background: #fff;
    }
    .auth-logo {
        width: 60px;
        margin-bottom: 1rem;
    }
</style>

<script>
    document.body.classList.add('register-bg');
</script>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 90vh;">
    <div class="col-md-6 col-lg-5">
        <div class="auth-card">
            <div class="text-center">
                <img src="/images/ecourja.jpg" alt="Ecourja Logo" class="auth-logo rounded-circle shadow-sm">
                <h3 class="mb-3 fw-bold" style="letter-spacing:1px;">Register</h3>
            </div>
            <%- include('./partials/messages') %>
            <form action="/register" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" id="username" name="username" class="form-control rounded-pill px-3 py-2" placeholder="Enter Username" value="<%= typeof username != 'undefined' ? username : '' %>" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" name="email" class="form-control rounded-pill px-3 py-2" placeholder="Enter Email" value="<%= typeof email != 'undefined' ? email : '' %>" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" name="password" class="form-control rounded-pill px-3 py-2" placeholder="Create Password" value="<%= typeof password != 'undefined' ? password : '' %>" required>
                </div>
                <div class="mb-3">
                    <label for="password2" class="form-label">Confirm Password</label>
                    <input type="password" id="password2" name="password2" class="form-control rounded-pill px-3 py-2" placeholder="Confirm Password" value="<%= typeof password2 != 'undefined' ? password2 : '' %>" required>
                </div>
                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 mt-2">Register</button>
            </form>
            <p class="mt-4 text-center text-secondary">
                Already have an account? <a href="/login" class="fw-semibold">Login</a>
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>